---
import '../styles/global.css';
import Navbar from '../components/core/Navbar.astro';
import Footer from '../components/core/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  platform?: string;
  schema?: object;
}

const {
  title = 'VidGet — Universal Video Downloader',
  description = 'Download videos from YouTube, TikTok, Instagram, Facebook, Twitter, Pinterest and 13+ platforms. Free, fast, no watermark.',
  lang = 'en',
  platform = '',
  schema,
} = Astro.props;

const isRTL = lang === 'ar';
const schemaStr = schema ? JSON.stringify(schema) : null;
---
<!DOCTYPE html>
<html lang={lang} dir={isRTL ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {schemaStr && (
      <script type="application/ld+json" set:html={schemaStr} />
    )}
  </head>
  <body data-platform={platform}>
    <Navbar lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
