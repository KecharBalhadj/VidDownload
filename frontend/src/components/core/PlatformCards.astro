---
import { PLATFORM_THEMES } from '../../utils/platforms';

const platforms = [
  { key: 'youtube', href: '/youtube-downloader' },
  { key: 'tiktok', href: '/tiktok-downloader' },
  { key: 'instagram', href: '/instagram-downloader' },
  { key: 'facebook', href: '/facebook-downloader' },
  { key: 'twitter', href: '/twitter-downloader' },
  { key: 'pinterest', href: '/pinterest-downloader' },
  { key: 'vimeo', href: '/vimeo-downloader' },
  { key: 'twitch', href: '/twitch-downloader' },
  { key: 'reddit', href: '/reddit-downloader' },
  { key: 'dailymotion', href: '/dailymotion-downloader' },
  { key: 'threads', href: '/threads-downloader' },
  { key: 'linkedin', href: '/linkedin-downloader' },
  { key: 'snapchat', href: '/snapchat-downloader' },
] as const;
---

<div class="platforms-grid">
  {platforms.map(({ key, href }) => {
    const theme = PLATFORM_THEMES[key];
    return (
      <a
        href={href}
        class="platform-card"
        style={`--p-primary: ${theme.primary}; --p-gradient: ${theme.gradient};`}
      >
        <span class="platform-emoji">{theme.emoji}</span>
        <span class="platform-name">{theme.name}</span>
      </a>
    );
  })}
</div>

<style>
.platforms-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap: 0.75rem;
}

.platform-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 0.75rem;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  text-decoration: none;
  transition: all 0.2s ease;
  cursor: pointer;
}

.platform-card:hover {
  border-color: var(--p-primary);
  background: color-mix(in srgb, var(--p-primary) 10%, var(--bg2));
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
}

.platform-emoji {
  font-size: 1.75rem;
  line-height: 1;
}

.platform-name {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--text-muted);
  text-align: center;
  transition: color 0.2s;
}

.platform-card:hover .platform-name {
  color: var(--text);
}
</style>
