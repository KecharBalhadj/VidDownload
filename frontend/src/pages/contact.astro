---
import Layout from '../layouts/Layout.astro';
import { getTranslations, type Lang } from '../utils/i18n';

const lang = (Astro.url.searchParams.get('lang') || 'en') as Lang;
const t = getTranslations(lang);
---

<Layout title={`${t.pages.contact_title} — VidGet`} description="Contact the VidGet team." lang={lang}>
  <div class="page-wrapper">
    <div class="container">
      <div class="page-header">
        <h1>{t.pages.contact_title}</h1>
        <p class="lead">{lang === 'ar' ? 'هل لديك سؤال؟ نحن هنا للمساعدة.' : 'Have a question? We\'re here to help.'}</p>
      </div>

      <div class="contact-layout">
        <div class="contact-form card" id="contactForm">
          <div class="form-field">
            <label class="form-label">{t.blog.name}</label>
            <input type="text" class="input-field" id="contactName" placeholder={lang === 'ar' ? 'اسمك' : 'Your name'} />
          </div>
          <div class="form-field">
            <label class="form-label">Email</label>
            <input type="email" class="input-field" id="contactEmail" placeholder={lang === 'ar' ? 'بريدك الإلكتروني' : 'your@email.com'} />
          </div>
          <div class="form-field">
            <label class="form-label">{t.blog.comment}</label>
            <textarea class="input-field msg-area" id="contactMsg" placeholder={lang === 'ar' ? 'رسالتك...' : 'Your message...'}></textarea>
          </div>
          <button class="btn btn-primary" id="sendBtn">{lang === 'ar' ? 'إرسال الرسالة' : 'Send Message'}</button>
          <div id="sendStatus" class="send-status" style="display:none"></div>
        </div>

        <div class="contact-info">
          {[
            { icon: '📧', title: 'Email', val: 'hello@vidget.app' },
            { icon: '🐦', title: 'Twitter', val: '@VidGetApp' },
            { icon: '💼', title: 'Business', val: 'business@vidget.app' },
          ].map(item => (
            <div class="info-card card">
              <span class="info-icon">{item.icon}</span>
              <div>
                <p class="info-title">{item.title}</p>
                <p class="info-val">{item.val}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { submitContact } from '../utils/api';
  const btn = document.getElementById('sendBtn') as HTMLButtonElement;
  const status = document.getElementById('sendStatus') as HTMLDivElement;
  btn?.addEventListener('click', async () => {
    const name = (document.getElementById('contactName') as HTMLInputElement).value;
    const email = (document.getElementById('contactEmail') as HTMLInputElement).value;
    const message = (document.getElementById('contactMsg') as HTMLTextAreaElement).value;
    if (!name || !email || !message) return;
    btn.disabled = true;
    btn.textContent = '...';
    try {
      await submitContact({ name, email, message });
      status.style.display = 'block';
      status.className = 'send-status success';
      status.textContent = '✓ Message sent successfully!';
    } catch {
      status.style.display = 'block';
      status.className = 'send-status error';
      status.textContent = '⚠ Failed to send. Please try again.';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Message';
    }
  });
</script>

<style>
.page-wrapper { padding: 4rem 0 6rem; position: relative; z-index: 1; }
.page-header { margin-bottom: 2.5rem; }
.page-header h1 { font-size: clamp(2rem, 5vw, 3.5rem); color: var(--text); margin-bottom: 0.75rem; }
.lead { color: var(--text-muted); font-size: 1.05rem; }
.contact-layout { display: grid; grid-template-columns: 1fr 280px; gap: 2.5rem; align-items: start; }
.contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
.form-field { display: flex; flex-direction: column; gap: 0.5rem; }
.form-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; color: var(--text-muted); text-transform: uppercase; }
.msg-area { min-height: 140px; resize: vertical; }
.send-status { padding: 0.75rem 1rem; border-radius: var(--radius); font-size: 0.875rem; font-weight: 700; }
.send-status.success { background: rgba(0,245,200,0.1); border: 1px solid rgba(0,245,200,0.3); color: var(--accent); }
.send-status.error { background: rgba(255,100,100,0.1); border: 1px solid rgba(255,100,100,0.3); color: #ff8888; }
.contact-info { display: flex; flex-direction: column; gap: 1rem; }
.info-card { display: flex; align-items: center; gap: 1rem; }
.info-icon { font-size: 1.5rem; flex-shrink: 0; }
.info-title { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.2rem; }
.info-val { color: var(--text); font-size: 0.9rem; }
@media (max-width: 768px) { .contact-layout { grid-template-columns: 1fr; } }
</style>
