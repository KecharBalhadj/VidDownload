---
import Layout from '../layouts/Layout.astro';
import { getTranslations, type Lang } from '../utils/i18n';
const lang = (Astro.url.searchParams.get('lang') || 'en') as Lang;
const t = getTranslations(lang);
---
<Layout title={`${t.pages.advertise_title} — VidGet`} description="Advertise with VidGet" lang={lang}>
  <div class="page-wrapper"><div class="container">
    <div class="page-header">
      <h1>{t.pages.advertise_title}</h1>
      <p class="lead">Reach millions of users downloading videos every day.</p>
    </div>
    <div class="ad-options-grid">
      {[
        { icon: '📊', name: 'Banner Ads', desc: 'Display banner ads across all pages.', cta: 'From $50/month' },
        { icon: '🎯', name: 'Targeted Ads', desc: 'Target users by platform interest and location.', cta: 'From $100/month' },
        { icon: '✉️', name: 'Newsletter', desc: 'Reach our newsletter subscribers directly.', cta: 'From $75/send' },
      ].map(opt => (
        <div class="ad-option card">
          <span class="ad-icon">{opt.icon}</span>
          <h3>{opt.name}</h3>
          <p>{opt.desc}</p>
          <span class="ad-price badge badge-primary">{opt.cta}</span>
        </div>
      ))}
    </div>
    <div class="contact-cta card">
      <h2>Interested? Contact Us</h2>
      <p>Email us at <a href="mailto:ads@vidget.app">ads@vidget.app</a> with your requirements and we'll get back to you within 24 hours.</p>
    </div>
  </div></div>
</Layout>
<style>
.page-wrapper { padding: 4rem 0 6rem; position: relative; z-index: 1; }
.page-header { margin-bottom: 3rem; }
.page-header h1 { font-size: clamp(2rem, 5vw, 3.5rem); color: var(--text); margin-bottom: 0.75rem; }
.lead { color: var(--text-muted); font-size: 1.05rem; }
.ad-options-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2rem; }
.ad-option { display: flex; flex-direction: column; gap: 0.75rem; }
.ad-icon { font-size: 2rem; }
.ad-option h3 { font-size: 1.1rem; color: var(--text); }
.ad-option p { color: var(--text-muted); font-size: 0.875rem; line-height: 1.6; flex: 1; }
.ad-price { align-self: flex-start; }
.contact-cta { max-width: 600px; display: flex; flex-direction: column; gap: 0.75rem; }
.contact-cta h2 { font-size: 1.3rem; color: var(--text); }
.contact-cta p { color: var(--text-muted); font-size: 0.95rem; }
@media (max-width: 768px) { .ad-options-grid { grid-template-columns: 1fr; } }
</style>
