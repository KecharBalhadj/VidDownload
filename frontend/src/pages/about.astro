---
import Layout from '../layouts/Layout.astro';
import { getTranslations, type Lang } from '../utils/i18n';

const lang = (Astro.url.searchParams.get('lang') || 'en') as Lang;
const t = getTranslations(lang);
const isAr = lang === 'ar';
---

<Layout title={`${t.pages.about_title} — VidGet`} description={t.pages.about_desc} lang={lang}>
  <div class="page-wrapper">
    <div class="container">
      <div class="page-header">
        <h1>{t.pages.about_title}</h1>
        <p class="lead">{t.pages.about_desc}</p>
      </div>

      <div class="about-content card">
        {isAr ? (
          <>
            <h2>ما هو VidGet؟</h2>
            <p>VidGet هو محمّل فيديو عالمي مجاني يدعم أكثر من 13 منصة بما في ذلك يوتيوب وتيك توك وإنستغرام وفيسبوك وتويتر وبينتريست وفيميو وتويتش والمزيد.</p>
            <h2>مهمتنا</h2>
            <p>هدفنا هو توفير أسهل وأسرع وأكثر موثوقية طريقة لتحميل مقاطع الفيديو المفضلة لديك. نحن نؤمن بأن الوصول إلى المحتوى يجب أن يكون بسيطاً وسريعاً ومجانياً.</p>
            <h2>التقنية</h2>
            <p>تم بناء VidGet باستخدام أحدث التقنيات بما في ذلك Astro للواجهة الأمامية وFlask Python للخلفية وyt-dlp لمعالجة الفيديو. نحن نستضيف على بنية تحتية موثوقة للتأكد من أن الخدمة متاحة دائماً.</p>
          </>
        ) : (
          <>
            <h2>What is VidGet?</h2>
            <p>VidGet is a free, universal video downloader that supports 13+ platforms including YouTube, TikTok, Instagram, Facebook, Twitter, Pinterest, Vimeo, Twitch, and more.</p>
            <h2>Our Mission</h2>
            <p>Our goal is to provide the easiest, fastest, and most reliable way to download your favorite videos. We believe that accessing content should be simple, fast, and free.</p>
            <h2>The Technology</h2>
            <p>VidGet is built using modern technologies including Astro for the frontend, Python Flask for the backend, and yt-dlp for video processing. We host on reliable infrastructure to ensure the service is always available.</p>
            <h2>Privacy First</h2>
            <p>We don't store your downloaded videos on our servers. All processing is done in real-time and links expire shortly after generation. Your privacy is our priority.</p>
          </>
        )}
      </div>

      <div class="stats-grid">
        {[
          { num: '13+', label: isAr ? 'منصة مدعومة' : 'Supported Platforms' },
          { num: '∞', label: isAr ? 'تحميل مجاني' : 'Free Downloads' },
          { num: '4K', label: isAr ? 'أعلى جودة' : 'Max Quality' },
          { num: '7', label: isAr ? 'لغة مدعومة' : 'Languages' },
        ].map(s => (
          <div class="stat-card card">
            <span class="stat-num">{s.num}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
.page-wrapper { padding: 4rem 0 6rem; position: relative; z-index: 1; }
.page-header { margin-bottom: 2.5rem; }
.page-header h1 { font-size: clamp(2rem, 5vw, 3.5rem); color: var(--text); margin-bottom: 0.75rem; }
.lead { color: var(--text-muted); font-size: 1.05rem; max-width: 600px; }
.about-content { margin-bottom: 3rem; display: flex; flex-direction: column; gap: 1rem; }
.about-content h2 { font-size: 1.3rem; color: var(--text); margin-top: 0.5rem; }
.about-content p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
.stat-card { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; padding: 2rem 1rem; text-align: center; }
.stat-num { font-size: 2.5rem; font-weight: 800; font-family: var(--font-display); color: var(--primary); }
.stat-label { font-size: 0.85rem; color: var(--text-muted); font-weight: 700; }
@media (max-width: 640px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
