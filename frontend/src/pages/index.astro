---
import Layout from '../layouts/Layout.astro';
import PlatformCards from '../components/core/PlatformCards.astro';
import VideoDownloader from '../components/core/VideoDownloader.tsx';
import Newsletter from '../components/newsletter/Newsletter.tsx';
import AdBanner from '../components/ads/AdBanner.astro';
import { getTranslations, type Lang, isRTL } from '../utils/i18n';

const lang = (Astro.url.searchParams.get('lang') || 'en') as Lang;
const t = getTranslations(lang);
const dir = isRTL(lang) ? 'rtl' : 'ltr';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "VidGet",
  "description": "Universal Multi-Platform Video Downloader",
  "url": "https://vidget.app",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<Layout
  title="VidGet — Universal Video Downloader | YouTube, TikTok, Instagram & More"
  description={t.hero.description}
  lang={lang}
  schema={schema}
>
  <!-- Hero Section -->
  <section class="hero" dir={dir}>
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge badge badge-primary">
          <span>⚡</span>
          <span>13+ Platforms Supported</span>
        </div>
        <h1 class="hero-title">
          {t.hero.title}
          <span class="hero-accent"> {t.hero.subtitle}</span>
        </h1>
        <p class="hero-desc">{t.hero.description}</p>
      </div>

      <!-- Main Downloader -->
      <div class="downloader-wrap">
        <VideoDownloader lang={lang} client:load />
      </div>

      <!-- Platform Cards -->
      <div class="platforms-section">
        <p class="platforms-label">{t.hero.supported}</p>
        <PlatformCards />
      </div>
    </div>
  </section>

  <!-- Ad Banner -->
  <div class="container" style="margin-top: 2rem;">
    <AdBanner slot="top-banner" size="leaderboard" />
  </div>

  <!-- Features Section -->
  <section class="features" dir={dir}>
    <div class="container">
      <h2 class="section-title">
        {lang === 'ar' ? 'لماذا VidGet؟' : 'Why VidGet?'}
      </h2>
      <div class="features-grid">
        {[
          { icon: '⚡', title: lang === 'ar' ? 'سريع جداً' : 'Lightning Fast', desc: lang === 'ar' ? 'تحميل فوري بدون انتظار' : 'Instant downloads, no waiting.' },
          { icon: '🎯', title: lang === 'ar' ? '13+ منصة' : '13+ Platforms', desc: lang === 'ar' ? 'يوتيوب، تيك توك، إنستغرام والمزيد' : 'YouTube, TikTok, Instagram & more.' },
          { icon: '🎬', title: lang === 'ar' ? 'جودة 4K' : '4K Quality', desc: lang === 'ar' ? 'من 144p حتى 4K' : 'From 144p up to 4K resolution.' },
          { icon: '🔇', title: lang === 'ar' ? 'بدون علامة مائية' : 'No Watermark', desc: lang === 'ar' ? 'تيك توك بدون علامة مائية' : 'TikTok videos without watermark.' },
          { icon: '🎵', title: lang === 'ar' ? 'صوت فقط' : 'Audio Only', desc: lang === 'ar' ? 'استخرج الصوت بصيغة MP3' : 'Extract audio as MP3.' },
          { icon: '🔒', title: lang === 'ar' ? 'آمن 100%' : '100% Safe', desc: lang === 'ar' ? 'لا تخزين، لا تتبع' : 'No storage, no tracking.' },
        ].map(f => (
          <div class="feature-card card">
            <span class="feature-icon">{f.icon}</span>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="newsletter-section">
    <div class="container">
      <Newsletter lang={lang} client:visible />
    </div>
  </section>

  <!-- Ad Banner Bottom -->
  <div class="container" style="margin-bottom: 2rem;">
    <AdBanner slot="bottom-banner" size="leaderboard" />
  </div>
</Layout>

<style>
.hero {
  padding: 5rem 0 3rem;
  position: relative;
  z-index: 1;
}

.hero-content {
  text-align: center;
  margin-bottom: 3rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
}

.hero-title {
  font-size: clamp(2.4rem, 6vw, 4.5rem);
  font-weight: 800;
  line-height: 1.1;
  color: var(--text);
  max-width: 800px;
}

.hero-accent {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: inline-block;
}

.hero-desc {
  color: var(--text-muted);
  font-size: 1.05rem;
  max-width: 560px;
  line-height: 1.7;
}

.downloader-wrap {
  max-width: 780px;
  margin: 0 auto;
  width: 100%;
}

.platforms-section {
  margin-top: 3rem;
  max-width: 780px;
  margin-inline: auto;
}

.platforms-label {
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 1rem;
  font-weight: 700;
  text-align: center;
}

.features {
  padding: 5rem 0;
  position: relative;
  z-index: 1;
}

.section-title {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  text-align: center;
  margin-bottom: 3rem;
  color: var(--text);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1.25rem;
}

.feature-card {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding: 1.75rem;
}

.feature-icon {
  font-size: 2rem;
  line-height: 1;
}

.feature-title {
  font-size: 1.05rem;
  color: var(--text);
  font-weight: 700;
}

.feature-desc {
  color: var(--text-muted);
  font-size: 0.875rem;
  line-height: 1.6;
}

.newsletter-section {
  padding: 2rem 0 4rem;
  position: relative;
  z-index: 1;
}
</style>
