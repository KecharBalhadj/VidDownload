---
import Layout from '../layouts/Layout.astro';
import { getTranslations, type Lang } from '../utils/i18n';
const lang = (Astro.url.searchParams.get('lang') || 'en') as Lang;
const t = getTranslations(lang);
---
<Layout title={`${t.pages.terms_title} — VidGet`} description="VidGet Terms of Service" lang={lang}>
  <div class="page-wrapper"><div class="container">
    <h1>{t.pages.terms_title}</h1>
    <div class="legal-content card">
      <h2>Acceptance of Terms</h2>
      <p>By using VidGet, you agree to these terms. If you disagree, please stop using the service.</p>
      <h2>Permitted Use</h2>
      <p>VidGet is intended for downloading videos for personal, non-commercial use only. You must respect the copyright and terms of service of the platforms from which you download content.</p>
      <h2>Prohibited Activities</h2>
      <p>You may not use VidGet to: download copyrighted content for commercial use, circumvent DRM protections, redistribute downloaded content, or abuse our service with automated requests.</p>
      <h2>Disclaimer</h2>
      <p>VidGet is provided "as is" without any warranties. We are not responsible for content downloaded through our service.</p>
      <h2>Changes</h2>
      <p>We reserve the right to modify these terms at any time. Continued use constitutes acceptance of changes.</p>
    </div>
  </div></div>
</Layout>
<style>
.page-wrapper { padding: 4rem 0 6rem; position: relative; z-index: 1; }
h1 { font-size: clamp(2rem, 5vw, 3.5rem); color: var(--text); margin-bottom: 2rem; }
.legal-content { display: flex; flex-direction: column; gap: 1.25rem; max-width: 800px; }
.legal-content h2 { font-size: 1.2rem; color: var(--text); }
.legal-content p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; }
</style>
